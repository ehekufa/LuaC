@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
if(@LUAC_WITH_MBEDTLS@)
    list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
    find_dependency(MbedTLS)
    list(POP_BACK CMAKE_MODULE_PATH)
endif()
if(@LUAC_WITH_MINIAUDIO@)
    find_dependency(Threads)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/LuaCTargets.cmake")
set_and_check(LuaC_RUNTIME_DIR "@PACKAGE_CMAKE_INSTALL_DATADIR@/luac")
set(LuaC_VERSION "@PROJECT_VERSION@")

check_required_components(LuaC)
